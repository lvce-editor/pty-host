{
  "name": "@lvce-editor/pty-host-monorepo",
  "version": "0.0.0-dev",
  "keywords": [
    "lvce-editor",
    "pty-host"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lvce-editor/pty-host.git"
  },
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "src/ptyHostMain.ts",
  "bin": "bin/ptyHost.js",
  "scripts": {
    "build": "node packages/build/src/build.js",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^17.6.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
